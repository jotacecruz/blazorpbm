@page "/users"
@using BlazorPBM.Models
@using BlazorPBM.Services
@inject UserService UserService

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<p>This component demonstrates fetching data from the server.</p>

@if (userList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>LastAccess</th>
            </tr>
        </thead>
        <tbody>
            @foreach (User user in userList)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.LastAccess.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<User>? userList;

    protected override async Task OnInitializedAsync()
    {
        userList = await UserService.GetAllUser();
    }
}

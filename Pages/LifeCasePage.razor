                                                    <RadzenLabel Text="Contact" Component="Contact" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.Contact Style="width: 100%;" Name="Contact" />

                                            </RadzenRow>
                                        </RadzenStack>
                                    </RadzenFieldset>
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="4" SizeMD="4">
                                <RadzenStack>
                                    <RadzenFieldset Text="Relative Info">
                                        <RadzenStack Gap="1rem">
                                            <RadzenRow AlignItems="AlignItems.Center">

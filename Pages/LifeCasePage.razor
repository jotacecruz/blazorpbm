                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.FirstName Style="width: 100%;" Name="FirstName" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="Last Name" Component="LastName" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.LastName Style="width: 100%;" Name="LastName" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="Address" Component="ResidenceAddress" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.ResidenceAddress Style="width: 100%;" Name="ResidenceAddress" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="City" Component="City" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.ResidenceCity Style="width: 100%;" Name="City" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">

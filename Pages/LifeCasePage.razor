                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="Weight" Component="Weight" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenNumeric @bind-Value=@lifeCase.Weight Placeholder="0.0" Step="0.5" Name="Weight" />

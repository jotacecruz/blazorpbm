                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="Relative SS#" Component="RelativeSocialSecurity" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.RelativeSocialSecurity Style="width: 100%;" Name="RelativeSocialSecurity" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenStack>
                                    </RadzenFieldset>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="REMARKS">
                        <RadzenDataGrid @ref="lifeCaseRemarkGrid" Data="@lifeCaseRemarkList" TItem="LifeCaseRemark" AllowSorting="true" AllowColumnResize="true" EditMode=DataGridEditMode.Single>
                            <HeaderTemplate>
                                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Click="@(async (item) => { await lifeCaseRemarkGrid.InsertRow(new LifeCaseRemark(){ LifeCaseId = lifeCase.LifeCaseId});})" />
                            </HeaderTemplate>
                            <Columns>
                                <RadzenDataGridColumn Property="Remark" Title="Remark">
                                    <EditTemplate Context="remark">
                                        <RadzenTextBox @bind-Value=@remark.Remark />
                                    </EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="Modified" Title="Modified" FormatString="{0:d}" />
                                <RadzenDataGridColumn Title="User"><Template Context="data">@data.Modifier?.Name</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                                    <Template Context="order">
                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => {})" @onclick:stopPropagation="true" />
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => {})" @onclick:stopPropagation="true" />
                                    </Template>
                                    <EditTemplate Context="order">
                                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveLifeCaseRemark(order))" aria-label="Save" />
                                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => {})" aria-label="Cancel" />
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => {})" aria-label="Delete" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </div>
    </div>
}

@code {
    RadzenDataGrid<LifeCaseRemark> lifeCaseRemarkGrid = new RadzenDataGrid<LifeCaseRemark>();

    private List<string> lifeCaseStatusList = new List<string>();
    private List<Company> companyList = new List<Company>();
    private List<Insured> insuredList = new List<Insured>();

    private List<LifeCase> lifeCaseList = new List<LifeCase>();
    private List<LifeCaseRemark> lifeCaseRemarkList = new List<LifeCaseRemark>();
    private LifeCase lifeCase = new LifeCase();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lifeCaseStatusList = await ReferenceDataService.GetAllStatus();
            companyList = await ReferenceDataService.GetAllCompany();
            insuredList = await InsuredService.GetAllInsured();
            lifeCaseList = await LifeCaseService.GetAllLifeCase();
        }
        catch (Exception ex)
        {
            ErrorService.ReportError(ex);
        }
    }

    public async Task SaveLifeCase()
    {
        try
        {
            await LifeCaseService.SaveLifeCase(lifeCase);
            lifeCaseList = await LifeCaseService.GetAllLifeCase();
            lifeCase = new LifeCase();
        }
        catch (Exception ex)
        {
            ErrorService.ReportError(ex);
        }
    }

    public async Task Cancel()
    {
        //
    }

    async Task SaveLifeCaseRemark(LifeCaseRemark item)
    {
        try
        {
            await LifeCaseRemarkService.SaveLifeCaseRemark(item);
            lifeCaseRemarkList = await LifeCaseRemarkService.GetAllLifeCaseRemark(item.LifeCaseId);
        }
        catch (Exception ex)
        {
            ErrorService.ReportError(ex);
        }
    }
}

                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="Relative Name" Component="RelativeName" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.RelativeName Style="width: 100%;" Name="RelativeName" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">

                                                    <RadzenLabel Text="SS#" Component="SocialSecurity" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.SocialSecurity Style="width: 100%;" Name="SocialSecurity" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="Tax#" Component="TaxIdNumber" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">
                                                    <RadzenTextBox @bind-Value=@lifeCase.TaxIdNumber Style="width: 100%;" Name="TaxIdNumber" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            <RadzenRow AlignItems="AlignItems.Center">
                                                <RadzenColumn Size="4" SizeMD="4">
                                                    <RadzenLabel Text="Height" Component="Height" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeMD="8">

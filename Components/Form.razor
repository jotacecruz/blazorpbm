    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? FormItems { get; set; }

    [Parameter]
    public RenderFragment? Buttons { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

